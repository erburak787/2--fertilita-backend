# =============================================================================
# Fertilita Backend — Environment Variables (KEYS ONLY)
#
# Copy this file to `.env` and fill the values.
# `.env` is gitignored. NEVER commit real secrets.
#
# ⚠️  Compliance note: this app stores GDPR Art. 9 special-category health
#    data. MONGODB_URI MUST point at an EU-region cluster (Frankfurt /
#    Dublin / Paris). See README §"Compliance".
# =============================================================================

# --- Server ---
PORT=
NODE_ENV=

# --- MongoDB (⚠️ EU-region cluster) ---
MONGODB_URI=
MONGODB_DB_NAME=

# --- JWT (user-facing access + refresh tokens) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# --- JWT (admin-facing, separate secret) ---
ADMIN_JWT_SECRET=
ADMIN_JWT_ACCESS_EXPIRES_IN=
ADMIN_JWT_REFRESH_EXPIRES_IN=

# --- OAuth: Apple Sign-In ---
# APPLE_CLIENT_ID is the Services ID (or bundle ID) registered with Apple.
# ⚠️ Must NOT be `app.rork.fertilita-foundation` — register the new bundle
#    with Apple Developer before filling.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- OAuth: Google Sign-In (one client ID per platform) ---
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# --- Expo Push Notifications ---
# Reminder copy MUST be opaque (no medication / procedure / partner names).
EXPO_ACCESS_TOKEN=

# --- Cloudflare R2 (S3-compatible). Required for the documents feature. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- RevenueCat (subscriptions). Required to run subscription features. ---
REVENUECAT_API_KEY_V1=
# Timing-safe compared against the `Authorization` header on /webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=

# --- Email (password reset). ---
# EMAIL_TRANSPORT: `console` prints to stdout (dev-only). `resend` uses Resend.
EMAIL_TRANSPORT=
# Verified from-address, e.g. no-reply@fertilita.app
EMAIL_FROM=
RESEND_API_KEY=
# Deep-link URL for the reset flow; app parses ?token= from this.
PASSWORD_RESET_URL_BASE=

# --- CORS ---
# Comma-separated list of allowed origins, e.g.
# https://admin.fertilita.app,https://staging-admin.fertilita.app
CORS_ORIGINS=
