{
  "name": "fertilita-backend",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "seed-admin": "bun run src/scripts/seed-admin.ts",
    "seed-support-messages": "bun run src/scripts/seed-support-messages.ts",
    "reset-admin-password": "bun run src/scripts/reset-admin-password.ts",
    "clear-db": "bun run clear-db.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "mongodb-memory-server": "^11.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/zod-validator": "^0.7.6",
    "bcryptjs": "^3.0.3",
    "expo-server-sdk": "^3.10.0",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "nanoid": "^5.1.6",
    "zod": "^4.2.1"
  }
}
